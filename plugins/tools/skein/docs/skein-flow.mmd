graph TB
  subgraph Route["请求路由"]
    REQ[用户请求] --> USER_PROMPT{user-prompt hook}
    USER_PROMPT -->|flow: 跨文件/多步| CREATE[建 task]
    USER_PROMPT -->|inline: 单文件小改 ≤20行| INLINE[直接改]
    USER_PROMPT -->|grey: 模糊| ASK[AskUserQuestion]
    USER_PROMPT -.->|纯查询/问答| INLINE
  end

  subgraph Config["配置核心 (config.yaml — 严格遵守)"]
    CFG["use_worktree / max_active<br/>auto_commit / retain_days<br/>spec_core_budget"]
    CFG -.->|use_worktree| CFG_WT[worktree 隔离 or 原地]
    CFG -.->|max_active| CFG_CC["task + subtask 共用并发上限<br/>(task: 仅 进行中 占槽, 就绪/检查中 不占;<br/>subtask: claim exec 标 running 占同一池)"]
    CFG -.->|auto_commit| CFG_AC[仅原地模式生效<br/>true: finish 自动 commit<br/>false: 改动留工作区交用户<br/>worktree 模式: 恒强制 commit]
    CFG -.->|retain_days| CFG_RD[归档保留期 默认7天]
    CFG -.->|spec.always_budget| CFG_CB["always 页全文软预算字符数<br/>默认 1000, 超 → maintain 降级"]
  end

  subgraph Workspace["工作区初始化 (一次性, 幂等)"]
    INIT{skein init / setup} --> CONFIG[config.yaml]
    INIT --> TASK_DIR[.skein/task/]
    INIT --> SPEC_DIR[".skein/spec/ (namespace × 类目)"]
    INIT --> WORKTREE_ROOT[".worktrees/ (use_worktree=true 时)"]
    INIT -.->|检测到 .trellis/| TRELLIS_MIG["skein setup<br/>兼容(留数据) / --full(整删)<br/>派 skein-setup agent 语义迁移"]
  end

  subgraph CreateTask["建 task (skein create) — 更新 task.json + 初始化文件夹"]
    CREATE --> C_JSON[更新 task.json<br/>status=待处理]
    CREATE --> C_FOLDER[初始化 task/&lt;id&gt;/ 文件夹]
    C_FOLDER --> C_PRD["prd.md 脚手架<br/>章节带 - [ ] TODO"]
    C_FOLDER --> C_DESIGN[design.md 脚手架<br/>含可能性分支 section]
    C_FOLDER -.->|不预建 findings.md<br/>仅调研时 researcher 增量生| C_NOFIND[无 findings 空壳]
    C_FOLDER -.->|subtask/契约 留空<br/>plan 阶段才填| C_EMPTY_DAG["task.json subtasks[]/contracts[] 空"]
  end

  subgraph Plan["Phase 1: 规划 — skein-plan"]
    C_JSON --> RECALL_BEFORE["memory recall<br/>派 skein-recaller<br/>skein-spec recall &lt;query&gt;<br/>注入 dispatch 已知段"]
    RECALL_BEFORE --> P0{cold-start 信号?<br/>无动词/无路径/&lt;15字/愿景腔}
    P0 -->|命中| P1[愿景翻译<br/>Job Story 三段<br/>said/implied/missing 三分<br/>Assumptions 段防埋]
    P0 -->|清晰输入| P2[Brainstorm 需求/方案]
    P1 --> P2
    P2 --> P3{research 判定门<br/>明确需/明确不需/<br/>保守灰区自动派/激进灰区问用户}
    P3 -->|是| RESEARCHER["skein-researcher<br/>代码勘察 + 外部搜索(agent-reach优先)<br/>边研边增量写 findings.md + research/"]
    P3 -->|否| P4_LOCK["锁定契约<br/>skein contract &lt;id&gt; --add<br/>MUST/禁/边界条件 逐条锁进 task.json"]
    RESEARCHER --> FINDINGS
    RESEARCHER --> P4_LOCK
    P4_LOCK --> P4{GriLL 硬门<br/>skein-grill 7 轴对抗审查}
    P4 -->|通过| P5[产出工件]
    P4 -->|不通过/弱点表未补齐| P6[回头修改方案<br/>禁 start]
    P6 --> P2
    P5 --> PRD[prd.md<br/>目标/边界/验收标准/索引]
    P5 --> DESIGN["design.md<br/>架构/取舍/技术选型/可能性分支<br/>+ ADR (难逆决策)"]
    FINDINGS["findings.md (仅调研时生)"]
    P5 --> DAG_CHECK{复杂度天花板?<br/>subtask &gt;8 / 跨≥2子系统 /<br/>工期风险高}
    DAG_CHECK -->|命中| SPLIT_ASK[AskUserQuestion<br/>拆多 task + task 级 --deps]
    DAG_CHECK -->|未命中| DAG[subtask DAG<br/>skein subtask add --deps<br/>协议先行后并行]
    SPLIT_ASK --> SUPERTASK{需 supertask?<br/>cold-start 收敛后判<br/>默认不建}
    SUPERTASK -->|是| SUPER[skein create --kind supertask<br/>child --parent 限2层]
    SUPERTASK -->|否| DAG
    SUPER --> DAG
    P5 --> CONTRACT_OUT["contracts[]<br/>已由 P4_LOCK 落盘"]
    DAG --> DEDUP["异步派 skein-dedup<br/>fire-and-forget, 不阻塞 exec<br/>查重归并 + 补执行序织 DAG"]
  end

  subgraph Confirm["规划确认 → 就绪 → 激活 (plan 与 exec 连接)"]
    PRD --> USER_CONFIRM{AskUserQuestion<br/>用户评审确认<br/>smart zone 内一气呵成}
    DESIGN --> USER_CONFIRM
    DAG --> USER_CONFIRM
    CONTRACT_OUT --> USER_CONFIRM
    USER_CONFIRM -->|通过| CONFIRM_CMD["skein confirm &lt;id&gt;<br/>用户确认门 (吸收 start): 验 prd + ≥1 subtask<br/>+ doctor 体检 + deps 校验 + 建 worktree<br/>待处理→进行中"]
    CONFIRM_CMD --> START[进行中]
    USER_CONFIRM -->|驳回| P6
  end

  subgraph Exec["Phase 2: 执行 — skein-exec (无验收, 执行完成即 done)"]
    START --> CLAIM{"skein claim exec<br/>(全局跨 task 竞争 max_active 槽)<br/>整批标 running + 占槽"}
    CLAIM -->|就绪 subtask| DISPATCH["dispatch 6 字段 prompt<br/>目标/已知/工作目录/输出/验收/失败<br/>+ Recursion Guard + 读后写硬门"]
    CLAIM -->|无 subtask, 仅本 task| NO_SUB[main 派 1 个 skein-executor<br/>单 task 无 subtask 兜底]
    CLAIM -->|"空: 满槽 running==max_active / 无就绪 subtask<br/>→ 查有无未规划 task"| PLAN_AHEAD["提前 plan 未规划 task (subtask 优先, plan 次级填充)<br/>skein-plan --continue 推到 planning-complete 待处理<br/>(仍待 confirm→就绪, 不自动过用户门; start 受 max_active 限)"]
    PLAN_AHEAD -->|回探: subtask 可派即放下 plan| CLAIM
    PLAN_AHEAD -.->|规划完成→待处理, 入 confirm→就绪→start 管线| USER_CONFIRM
    DISPATCH --> EXECUTE[执行: 派合适 agent<br/>无则 skein-executor, 共享 task worktree]
    NO_SUB --> EXECUTE
    EXECUTE -->|完成| DONE["skein subtask done<br/>(执行完成即完成, 不勾验收)"]
    EXECUTE -->|出错/阻塞| TIGHT["🟢 tight feedback loop<br/>先建复现命令(就红) 固定症状<br/>再读根因修, 无复现=猜"]
    TIGHT --> HEAL[自愈: 原地重派 ≤2轮<br/>或加修复 subtask 定点修根因<br/>--deps 挂失败源]
    HEAL --> CLAIM
    EXECUTE -.->|暴露超 task 边界问题| NEW_TASK["自主拆新 task<br/>skein-plan/create 登记<br/>--deps 连边 or 并行<br/>当前 task 按原 scope 收束"]
    NEW_TASK --> CLAIM
    DONE --> NEXT{本 task subtask 全 done?}
    NEXT -->|否, 还有就绪| CLAIM
    NEXT -->|是| TASK_CHECK["skein check &lt;id&gt;<br/>该 task → 检查中 (独立阶段, 不占 max_active 槽)"]
    TASK_CHECK --> MORE_TASK{还有未完成 task?}
    MORE_TASK -->|是, 继续调度| CLAIM
    MORE_TASK -->|否| EXEC_PAUSE[全部 task 完成<br/>exec 暂停工作]
    ASYNC_OUT["回合末输出 4 列任务清单<br/>id/状态/摘要/进度%<br/>(异步派出时 MUST 输出)"]
  end

  subgraph Check["Phase 3: 检查 — skein-check (唯一验收方)"]
    TASK_CHECK --> CKPT["1. checkpoint 核对<br/>task 验收(prd acceptance 未勾项)+<br/>subtask --check 验收 checklist<br/>已 -[x] 项跳过不重验"]
    CKPT --> CONTRACT_CHK["2. 契约逐条验证 (通用, 非仅编程类)<br/>skein contract &lt;id&gt; 列全部契约<br/>逐条核对 pass/fail"]
    CONTRACT_CHK --> CONSIST_CHK["3. 一致性核查 (通用)<br/>subtask 产物间 + 与 prd 契约<br/>有无冲突: 接口/重复实现/命名/数据流/契约矛盾"]
    CONSIST_CHK --> BUILTIN["4. 场景自适应内置 check<br/>(按项目特征探测, 多特征并存跑多类)"]
    BUILTIN --> CODE_CHK["编程类: build/test/lint/type<br/>+ 架构一致性"]
    BUILTIN --> NOVEL_CHK["小说类: 逻辑一致性<br/>+ 设定/伏笔一致性"]
    BUILTIN --> DATA_CHK["数据/ETL 类: schema 校验<br/>+ 管道跑通 + 字段一致 + 样本抽检"]
    BUILTIN --> DOC_CHK["文档/知识类: 链接有效<br/>+ 结构完整 + 术语一致 + 交叉引用"]
    BUILTIN --> CONF_CHK["配置/基建类: 语法校验<br/>+ 幂等 + dry-run + 依赖锁一致"]
    BUILTIN --> UI_CHK["设计/前端类: 组件渲染<br/>+ 可访问性 + 视觉回归 + 响应式"]
    CODE_CHK --> CHECK_VERIFY{全部通过 + 零冲突?}
    NOVEL_CHK --> CHECK_VERIFY
    DATA_CHK --> CHECK_VERIFY
    DOC_CHK --> CHECK_VERIFY
    CONF_CHK --> CHECK_VERIFY
    UI_CHK --> CHECK_VERIFY
    CONTRACT_CHK --> CHECK_VERIFY
    CONSIST_CHK --> CHECK_VERIFY
    CHECK_VERIFY -->|是| CHECK_WRITE["本轮通过验收项回写 -[x]<br/>skein prd check --type=acceptance<br/>未过项保持 -[ ] 留待修复重验"]
    CHECK_WRITE --> CHECK_PASS[检查通过]
    CHECK_VERIFY -->|否 ≤2轮| REPLAN["回 planning 重确认 (task 保持 进行中, 非状态变更)<br/>grill/AskUserQuestion 确认修复方向<br/>方案性→补 design/prd/契约<br/>定点→加修复 subtask (--deps 失败源)<br/>确认无误回 exec"]
    REPLAN --> CLAIM
    CHECK_VERIFY -->|否 ≥3轮| RCA[Root Cause Protocol<br/>5维: 需求/设计/实现/环境/测试<br/>每维附证据 file:line + 报错原文]
    RCA -->|带根因重修: ③④⑤维 可修层| REPLAN
    RCA -->|①②维 超exec 范围| HUMAN[停手 转人工<br/>附根因报告 + 退 planning 建议]
  end

  subgraph Finish["Phase 4: 收束 — skein-finish"]
    CHECK_PASS --> INSPECT[收尾勘察<br/>派 skein-finisher 只读 diff+悬挂残留<br/>不做验收核对]
    INSPECT --> CLEAN_SUB["main 清悬挂后台 agent<br/>本 task 派出的均已结束<br/>未关 = 未闭环 禁 finish"]
    CLEAN_SUB --> FINISH_CMD["skein finish &lt;id&gt;<br/>原子动作: commit→merge→销 worktree→标记完成<br/>检查中→已完成 (归档=保留期后自动迁移)"]
    FINISH_CMD --> AUTO_COMMIT_CHK{worktree?<br/>是: 强制 commit<br/>否: 才看 auto_commit}
    AUTO_COMMIT_CHK --> ASYNC["异步 fire-and-forget agent<br/>(finish 已闭环, 不阻塞)"]
    ASYNC --> SPECER["skein-specer<br/>sediment + prune"]
    ASYNC --> AUTO_FIX["auto-fix 双保险<br/>检测 .pending-fix 标记<br/>(Stop hook 漏检兜底)<br/>有→bg 派 specer 跑 maintain --apply"]
    SPECER --> WIKI_AMEND["wiki amend 回写<br/>异步 fire-and-forget<br/>sediment 落盘后 amend 回写 wiki 页"]
    WIKI_AMEND --> TRACE["回传到达后 main 补 output trace<br/>(sediment 判定不输出 trace = 流程错误)"]
  end

  subgraph Memory["规则记忆系统 (异步)"]
    SPECER --> SEDIMENT{Sediment 判定门<br/>5 正向项 + 3 排除项}
    SEDIMENT -->|违反即错, 命令式契约| CORE[spec/core/&lt;类目&gt;/]
    SEDIMENT -->|值得参考, ADR/陷阱型| RECALL[spec/recall/&lt;类目&gt;/]
    SEDIMENT -->|一次性/私有/已覆盖| DROP[丢弃]
    SPECER --> PRUNE["prune (sediment 后顺跑)<br/>5 判据自动 archive (可逆)<br/>stale/keywords重复/废弃/断链/core超预算"]
    SPECER --> MAINTAIN["maintain (手动体检, --apply 自动修)<br/>5 判据 + 2 补充发现<br/>断链只报告"]
    SPEC_INIT[SessionStart hook] --> CORE_INJECT["注入 core 极简索引 (仅标题)<br/>~400 token (INDEX_BUDGET_TOKENS)<br/>超 budget 提示跑 maintain"]
    SUBAGENT_INIT[SubagentStart hook] --> SUBAGENT_INJECT["注入 core 全文 (按 agent 类目过滤)<br/>~2000 token (SUBAGENT_BUDGET_TOKENS)<br/>+ spec 纪律提示"]
    PLAN_MEM[plan 阶段] --> RECALLER["skein-recaller<br/>skein-spec recall &lt;query&gt;<br/>main 等结果进 planning"]
    RECALLER --> FTS5["FTS5 BM25 检索<br/>(全 namespace, 跳 inclusion=always)"]
    FTS5 --> INJECT_R[注入 planning dispatch 已知段]
    EMPTY[首次空仓 + 代码有体量] --> BOOTSTRAP["记忆库 skill bootstrap 模式<br/>main 提议 + AskUserQuestion 征同意<br/>派 skein-researcher 扫 5 维约定<br/>候选定 ns×inclusion + sediment 写盘"]
    DRIFT[大重构/换栈/记忆漂移/接手可疑仓] --> RECONSTRUCT["记忆库 skill reconstruct 模式<br/>6 档深度 (recall/low/full/deep/max/high)<br/>archive (可逆) + 分型扫描 + 重建"]
    BOOTSTRAP --> WRITE[写盘 + 自动 reindex<br/>skein-spec sediment --namespace --inclusion<br/>--category --title --keywords --body-file]
    RECONSTRUCT --> WRITE
    CORE --> WRITE
    RECALL --> WRITE
    AUTO_HOOK[Stop hook 回合结束] --> PENDING_CHK[检测 spec 问题<br/>写 .pending-fix 标记]
    PENDING_CHK --> AUTO_FIX_MEM["main bg 派 skein-specer<br/>跑 maintain --apply 全自动修<br/>fire-and-forget"]
  end

  subgraph Architecture["组件架构"]
    HOOKS[Hook 系统<br/>SessionStart/SubagentStart/<br/>PreToolUse/Stop/user-prompt] --> SKILLS[Skill 编排层<br/>9 个 skein-* skills]
    SKILLS --> AGENTS[Agent 执行层<br/>skein-executor / -checker /<br/>-researcher / -finisher /<br/>-specer / -recaller / -setup]
    AGENTS --> SCRIPTS["CLI 引擎<br/>skein / skein-spec / skein-hooks"]
    SCRIPTS --> WORKSPACE[".skein/ 工作区<br/>+ .worktrees/ (可选)"]
    CFG -.->|真值源| SCRIPTS
  end

  subgraph Exception["异常处理"]
    ARCHIVE_ANY[skein archive] -.->|任意状态可丢弃| FINISH_CMD
    CONFLICT[finish merge 冲突] --> RESOLVE["5 步纪律: see state / find intent /<br/>resolve each hunk / run checks / finish<br/>🛑 禁 --abort, 禁 invent new behavior"]
    RESOLVE -->|解不开| MANUAL["停手 保留 worktree<br/>报用户裁 (附双方 commit + intent)<br/>禁强制覆盖"]
    INPLACE_NO_COMMIT["原地模式 + auto_commit=false<br/>有未提交改动"] --> LEAVE_UNCOMMITTED["finish 照常完成<br/>改动留工作区<br/>汇报提示用户自行 commit"]
    SUBAGENT_LEFT[悬挂后台 agent 未结束] --> RETRY_STOP[main 重试清理<br/>仍在 → 禁 finish 未闭环]
  end

  style CREATE fill:#4a9eff,color:#fff
  style CFG fill:#00bcd4,color:#000
  style PRD fill:#f9f,color:#000
  style USER_CONFIRM fill:#ffeb3b,color:#000
  style CONFIRM_CMD fill:#ffb74d,color:#000
  style CKPT fill:#8bc34a,color:#000
  style CONTRACT_CHK fill:#8bc34a,color:#000
  style CONSIST_CHK fill:#8bc34a,color:#000
  style CHECK_PASS fill:#8bc34a,color:#000
  style CORE fill:#4caf50,color:#fff
  style RECALL fill:#ff9800,color:#fff
  style FINISH_CMD fill:#9e9e9e,color:#fff
  style ASYNC fill:#ce93d8,color:#000
  style AUTO_FIX fill:#ce93d8,color:#000
  style ASK fill:#ffeb3b,color:#000
  style INLINE fill:#e0e0e0,color:#000
  style TIGHT fill:#ff8a80,color:#000

  %% bash 脚本节点标记 (红粗框 = 该节点直接跑 skein / skein-spec / skein-hooks CLI)
  classDef script stroke:#d32f2f,stroke-width:3px;
  class USER_PROMPT,INIT,CREATE,CONFIRM_CMD,START,CLAIM,DONE,TASK_CHECK,FINISH_CMD,ARCHIVE_ANY,RECALLER,BOOTSTRAP,RECONSTRUCT,SPEC_INIT,SUBAGENT_INIT,AUTO_HOOK,PENDING_CHK script;
  LEGEND["▨ 红粗框 = bash 脚本节点<br/>(skein / skein-spec / skein-hooks CLI)"]:::script
