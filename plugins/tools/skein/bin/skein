#!/usr/bin/env python3
"""skein — py wrapper, stdout JSON-only except `serve`."""
import os, sys, runpy
from _jsonwrap import run_json

_root = os.environ.get("CLAUDE_PLUGIN_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_target = os.path.join(_root, "scripts", "skein.py")
sys.argv[0] = _target
if len(sys.argv) > 1 and sys.argv[1] == "serve":
    runpy.run_path(_target, run_name="__main__")
else:
    run_json(_target)
