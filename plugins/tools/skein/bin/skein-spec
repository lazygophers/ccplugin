#!/usr/bin/env python3
"""skein-spec — py wrapper, stdout JSON-only."""
import os, sys
from _jsonwrap import run_json

_root = os.environ.get("CLAUDE_PLUGIN_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_target = os.path.join(_root, "scripts", "spec.py")
sys.argv[0] = _target
run_json(_target)
